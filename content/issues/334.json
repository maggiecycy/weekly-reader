            },
            {
              "text": "YAML 脚本",
              "url": "https://midscenejs.com/zh/automate-with-scripts-in-yaml.html"
            },
            {
              "text": "Midscene.js",
              "url": "https://midscenejs.com/zh/"
            }
          ],
